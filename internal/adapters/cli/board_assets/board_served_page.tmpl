{{define "boardServedPage"}}<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>{{.Style}}</style>
</head>
<body>

<header class="board-header">
  <div class="board-header-left">
    <h1>{{.UI.ProductName}}</h1>
    <p class="board-subtitle">{{.UI.BoardSubtitle}}</p>
  </div>
  <div class="board-header-right">
    {{if .WritesEnabled}}<button class="btn btn-accent" id="board-new-task-btn" type="button">{{.UI.NewTask}}</button>{{end}}
  </div>
</header>

<main data-board-main data-board-endpoint="/api/board" data-board-route="/" class="board-main">

{{if .HasBanner}}<div class="board-banner{{if .BannerIsError}} board-banner-error{{end}}" role="status">{{.BannerMessage}}</div>{{end}}

{{template "boardWorkflowSection" .}}

<!-- Collapsible auxiliary sections -->
<details class="board-details">
<summary>{{.UI.ActivityDiagnostics}}</summary>

<section style="margin-bottom:12px;">
<h2 style="font-size:0.85rem;font-weight:600;color:var(--ink);margin:0 0 6px;">{{.UI.Search}}</h2>
<form data-board-search-form class="board-search">
<input id="board-search-query" name="search" type="search" value="{{.SearchQuery}}" placeholder="{{.UI.SearchPlaceholder}}" />
<select name="entity_type">
<option value="all">{{.UI.SearchAll}}</option>
<option value="issue"{{if eq .SelectedEntityType "issue"}} selected{{end}}>{{.UI.SearchIssue}}</option>
<option value="comment"{{if eq .SelectedEntityType "comment"}} selected{{end}}>{{.UI.SearchComment}}</option>
<option value="decision"{{if eq .SelectedEntityType "decision"}} selected{{end}}>{{.UI.SearchDecision}}</option>
<option value="review"{{if eq .SelectedEntityType "review"}} selected{{end}}>{{.UI.SearchReview}}</option>
<option value="attempt_note"{{if eq .SelectedEntityType "attempt_note"}} selected{{end}}>{{.UI.SearchAttemptNote}}</option>
</select>
<button class="btn btn-sm" type="submit">{{.UI.SearchBtn}}</button>
</form>
<div data-board-search-status role="status" aria-live="polite">{{.SearchStatusMessage}}</div>
<div data-board-search-results>
{{if .SearchHasResults}}
<ul>
{{range .SearchResults}}
<li><strong>{{.Title}}</strong><div>{{.EntityType}} • {{.EntityID}}</div><div>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.IssueLabel}}</a>{{else}}<span class="empty">{{$.UI.NoOwningIssue}}</span>{{end}}</div><div>{{.Snippet}}</div></li>
{{end}}
</ul>
{{if .SearchHasMore}}<button class="btn btn-sm" type="button">{{.UI.LoadMore}}</button>
{{end}}
{{else if not .SearchIsInitial}}{{if .SearchInvalid}}<p class="board-empty">{{.UI.SearchInvalid}}</p>{{else if .SearchError}}<p class="board-empty">{{.UI.SearchUnavail}}</p>{{else}}<p class="board-empty">{{.UI.SearchNoResults}}</p>{{end}}{{else}}<p class="board-empty">{{.UI.SearchInitialHelp}}</p>{{end}}
</div>
</section>

<section style="margin-bottom:12px;">
<h2 style="font-size:0.85rem;font-weight:600;color:var(--ink);margin:0 0 6px;">{{.UI.StatusCounts}}</h2>
{{if .StatusCounts}}
<div class="table-scroll"><table>
<thead><tr><th>{{.UI.DefaultStatus}}</th><th>{{.UI.Count}}</th></tr></thead>
<tbody>
{{range .StatusCounts}}<tr><td>{{.Status}}</td><td>{{.Count}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="board-empty">{{.UI.NoIssuesYet}}</p>
{{end}}
</section>

<section style="margin-bottom:12px;">
<h2 style="font-size:0.85rem;font-weight:600;color:var(--ink);margin:0 0 6px;">{{.UI.ActiveAttempts}}</h2>
<p class="board-generated">{{.ActiveReservationCount}}{{.UI.ReservationSummary}}</p>
{{if .ActiveAttempts}}
<div class="table-scroll"><table>
<thead><tr><th>{{.UI.AttemptID}}</th><th>{{.UI.AttemptIssue}}</th><th>{{.UI.AttemptTitle}}</th><th>{{.UI.AttemptKind}}</th><th>{{.UI.AttemptSession}}</th><th>{{.UI.AttemptInstance}}</th><th>{{.UI.AttemptClient}}</th><th>{{.UI.AttemptModel}}</th><th>{{.UI.AttemptWorktree}}</th><th>{{.UI.AttemptStarted}}</th><th>{{.UI.AttemptLease}}</th><th>{{.UI.AttemptReservations}}</th><th>{{.UI.AttemptGates}}</th></tr></thead>
<tbody>
{{range .ActiveAttempts}}<tr><td>{{.AttemptID}}</td><td>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.IssueLabel}}</a>{{else}}{{.IssueLabel}}{{end}}</td><td>{{.IssueTitle}}</td><td>{{.Kind}}</td><td>{{.SessionLabel}}</td><td>{{.SessionInstanceKey}}</td><td>{{.SessionClientName}}</td><td>{{.SessionModel}}</td><td>{{.SessionWorktree}}</td><td>{{.StartedAt}}</td><td>{{.LeaseExpiresAt}}</td><td>{{if .HasReservations}}<ul class="board-reservations">{{range .Reservations}}<li>{{.Kind}}: {{.DisplayValue}}</li>
{{end}}</ul>{{else}}—{{end}}</td><td>{{.GateProgress}}{{if .HasGateUnmet}}<ul class="gates">{{range .GateUnmet}}<li>{{.}}</li>
{{end}}</ul>{{end}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="board-empty">{{.UI.NoActiveAttempts}}</p>
{{end}}
{{if .ActiveAttemptsTruncated}}<p class="board-truncated">{{.UI.ActiveAttemptsTruncated}}</p>{{end}}
{{if .ActiveReservationsTruncated}}<p class="board-truncated">{{.UI.ReservationsTruncated}}</p>{{end}}
</section>

<section style="margin-bottom:12px;">
<h2 style="font-size:0.85rem;font-weight:600;color:var(--ink);margin:0 0 6px;">{{.UI.BlockedIssues}}</h2>
{{if .BlockedIssues}}
<div class="table-scroll"><table>
<thead><tr><th>{{.UI.BlockedIssue}}</th><th>{{.UI.BlockedTitle}}</th><th>{{.UI.BlockedReasonCol}}</th></tr></thead>
<tbody>
{{range .BlockedIssues}}<tr><td>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.Label}}</a>{{else}}{{.Label}}{{end}}</td><td>{{.Title}}</td><td>{{.BlockedReason}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="board-empty">{{.UI.NoBlockedIssues}}</p>
{{end}}
{{if .BlockedIssuesTruncated}}<p class="board-truncated">{{.UI.BlockedIssuesTruncated}}</p>{{end}}
</section>

<section style="margin-bottom:12px;">
<h2 style="font-size:0.85rem;font-weight:600;color:var(--ink);margin:0 0 6px;">{{.UI.OpenReviewRequests}}</h2>
{{if .ReviewRequests}}
<div class="table-scroll"><table>
<thead><tr><th>{{.UI.ReviewRequestIDCol}}</th><th>{{.UI.ReviewIssueCol}}</th><th>{{.UI.ReviewStatusCol}}</th><th>{{.UI.ReviewTargetVersionCol}}</th><th>{{.UI.ReviewCreatedAtCol}}</th></tr></thead>
<tbody>
{{range .ReviewRequests}}<tr><td>{{.ID}}</td><td>{{if .HasIssueLink}}<a href="{{.IssueHref}}">{{.IssueLabel}}</a>{{else}}{{.IssueLabel}}{{end}}</td><td>{{.Status}}</td><td>{{.TargetVersion}}</td><td>{{.CreatedAt}}</td></tr>
{{end}}</tbody>
</table></div>
{{else}}<p class="board-empty">{{.UI.NoOpenReviewRequests}}</p>
{{end}}
{{if .ReviewRequestsTruncated}}<p class="board-truncated">{{.UI.ReviewRequestsTruncated}}</p>{{end}}
</section>

<section>
<h2 style="font-size:0.85rem;font-weight:600;color:var(--ink);margin:0 0 6px;">{{.UI.PlanningGraph}}</h2>
<p class="board-generated">{{.PlanningGraphSummary}}</p>
<div class="board-graph">{{.PlanningGraphSVG}}</div>
<details>
<summary>{{.UI.MermaidSource}}</summary>
<pre>{{.PlanningGraphMermaid}}</pre>
</details>
</section>
</details>

</main>

<!-- New Task Modal -->
{{if .WritesEnabled}}
<div class="modal-overlay" id="board-new-task-modal" hidden>
  <div class="modal">
    <button class="modal-close" id="board-modal-close-btn" type="button" aria-label="Close">&times;</button>
    <h2>{{.UI.NewTaskModalHeading}}</h2>
    <form class="board-form" method="post" action="/api/issues" data-board-write-form>
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <label>{{.UI.FieldTitle}} <input type="text" name="title" maxlength="300" required></label>
      <label>{{.UI.FieldDescription}} <textarea name="description" rows="3"></textarea></label>
      <label>{{.UI.FieldAcceptanceCriteria}} <textarea name="acceptance_criteria" rows="3"></textarea></label>
      <label>{{.UI.FieldPriority}} <select name="priority"><option value="" selected>{{.UI.FieldDefaultPriority}}</option>{{range .Priorities}}<option value="{{.}}">{{.}}</option>{{end}}</select></label>
      <label>{{.UI.FieldStatus}} <select name="status"><option value="open" selected>{{.UI.StatusOpen}}</option><option value="ready">{{.UI.StatusReady}}</option></select></label>
      <div class="board-form-actions">
        <button class="btn" type="button" id="board-modal-cancel-btn">{{.UI.Cancel}}</button>
        <button class="btn btn-primary" type="submit">{{.UI.CreateTask}}</button>
      </div>
    </form>
  </div>
</div>
{{end}}

<script>{{.LiveRefreshScript}}</script>
<script>{{.SearchScript}}</script>
<script>
(function(){
  // New Task modal toggle
  var newTaskBtn = document.getElementById('board-new-task-btn');
  var modal = document.getElementById('board-new-task-modal');
  var closeBtn = document.getElementById('board-modal-close-btn');
  var cancelBtn = document.getElementById('board-modal-cancel-btn');

  function showModal() {
    if (modal) modal.hidden = false;
  }

  function hideModal() {
    if (modal) modal.hidden = true;
  }

  if (newTaskBtn && modal) {
    newTaskBtn.addEventListener('click', showModal);
    if (closeBtn) closeBtn.addEventListener('click', hideModal);
    if (cancelBtn) cancelBtn.addEventListener('click', hideModal);
    modal.addEventListener('click', function(e) {
      if (e.target === modal) hideModal();
    });
  }

  // Check for modal state in live refresh
  window.__agentBoardModalOpen = function() {
    return modal && !modal.hidden;
  };

  // Mark refresh status element
  var root = document.querySelector('main[data-board-main]');
  if (root) {
    var statusEl = document.createElement('div');
    statusEl.id = 'board-refresh-status';
    statusEl.setAttribute('role', 'status');
    statusEl.setAttribute('aria-live', 'polite');
    statusEl.className = 'board-stale';
    if (root.parentNode) {
      root.parentNode.insertBefore(statusEl, root);
    }
  }
})();
</script>
<footer class="board-footer">{{.UI.ProductName}} {{.UI.FooterSuffix}} · {{.UI.GeneratedAt}} {{.GeneratedAt}}</footer>
</body>
</html>
{{end}}